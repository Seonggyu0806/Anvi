<UserControl x:Class="DiePipeline.Wpf.Views.GraphEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiePipeline.Wpf.ViewModels"
             xmlns:conv="clr-namespace:DiePipeline.Wpf.Converters"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify">

    <!--
        ★ 블록 편집기 화면 — 팔레트 · 캔버스 · 속성 · 검증. DataContext 는 GraphEditorViewModel.
          die 탭과 웨이퍼 편집 탭이 <b>같은 이 화면</b>을 쓴다. 탭마다 다른 것은 오른쪽 아래 한 칸(SideContent)뿐이다.
          베껴서 두 벌을 두면 한쪽만 고쳐지는 날이 온다.
        ★ 캔버스는 Nodify(교수님과 같다) — 포트 점에서 점으로 끌어 잇고, 휠로 확대 · 축소, 오른쪽 버튼으로 끌어 이동한다.
    -->
    <UserControl.Resources>
        <conv:CategoryToBrushConverter x:Key="CategoryBrush" />
        <conv:ErrorToBrushConverter x:Key="ErrorBrush" />
        <conv:InverseBoolToVisibilityConverter x:Key="HideWhenTrue" />
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />

        <!--
            ★★ 속성폼의 핵심. ParamDescriptor → PropertyField → 여기서 컨트롤이 정해진다.
              종류별 틀 네 개만 둔다. 노드 타입별 틀은 <b>하나도 없다</b>.
              여기에 "Binarize 용 틀" 을 만드는 순간 이 층이 죽는다.
        -->
        <DataTemplate x:Key="BoolTemplate">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding BoolValue}" ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate x:Key="ChoiceTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding StringValue}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NumberTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                <!-- UpdateSourceTrigger=PropertyChanged — 한 글자 칠 때마다 반영. 그래야 검증이 바로 돈다 -->
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                    ★ 슬라이더. 위아래 끝이 다 있는 값에만 뜬다(HasRange).
                      끝이 하나뿐인 값(minArea)엔 안 뜬다 — 화면이 끝을 지어내지 않는다.
                      IsSnapToTickEnabled + Step — 홀수만 받는 칸은 2칸씩이라 짝수에 못 멈춘다.
                -->
                <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                        TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                        Value="{Binding NumberValue}" Margin="0,2,0,0">
                    <Slider.Style>
                        <Style TargetType="Slider">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRange}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Slider.Style>
                </Slider>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!-- 경로 — 입력칸 + 찾아보기. 고른 파일은 레시피 폴더 기준 상대 경로로 적힌다 -->
        <DataTemplate x:Key="PathTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="찾아보기" Command="{Binding BrowseCommand}" Padding="6,0" Margin="3,0,0,0" />
                    <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Control 값을 보고 위 틀 중 하나를 고른다. 기본은 Text -->
        <DataTemplate DataType="{x:Type vm:PropertyFieldViewModel}">
            <ContentControl Content="{Binding}" Margin="0,4">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource TextTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Control}" Value="Bool">
                                <Setter Property="ContentTemplate" Value="{StaticResource BoolTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Control}" Value="Choice">
                                <Setter Property="ContentTemplate" Value="{StaticResource ChoiceTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Control}" Value="Integer">
                                <Setter Property="ContentTemplate" Value="{StaticResource NumberTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Control}" Value="Number">
                                <Setter Property="ContentTemplate" Value="{StaticResource NumberTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Control}" Value="Path">
                                <Setter Property="ContentTemplate" Value="{StaticResource PathTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <!--
            ★ 목록 · 묶음 값의 '행 목록' 부품 — 표식 자리 · 표식 조각 · 원판 · 수동 지정이 같은 틀을 쓴다.
              칸 종류(글자 · 고르기 · 경로)는 위 낱개 칸과 같은 방법(Control 값)으로 고른다.
        -->
        <DataTemplate x:Key="CellTextTemplate">
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Header}" Margin="0,0,2,0" />
        </DataTemplate>

        <DataTemplate x:Key="CellChoiceTemplate">
            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Text}" ToolTip="{Binding Header}" Margin="0,0,2,0" />
        </DataTemplate>

        <DataTemplate x:Key="CellPathTemplate">
            <DockPanel Margin="0,0,2,0">
                <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseCommand}" Padding="5,0" Margin="2,0,0,0"
                        ToolTip="찾아보기 — 레시피 폴더 기준 상대 경로로 적는다" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Header}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ListCellViewModel}">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource CellTextTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Control}" Value="Choice">
                                <Setter Property="ContentTemplate" Value="{StaticResource CellChoiceTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Control}" Value="Path">
                                <Setter Property="ContentTemplate" Value="{StaticResource CellPathTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ListParamViewModel}">
            <Border BorderBrush="#D9DFEA" BorderThickness="1" CornerRadius="3" Padding="5,3" Margin="0,8,0,2">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+ 추가" Command="{Binding AddCommand}" Padding="6,0" FontSize="11"
                                Visibility="{Binding IsList, Converter={StaticResource ShowWhenTrue}}" />
                        <CheckBox DockPanel.Dock="Right" Content="씀" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                  Visibility="{Binding IsOptional, Converter={StaticResource ShowWhenTrue}}" />
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="{Binding Title, Mode=OneWay}" />
                            <Run Text="{Binding Name, StringFormat=({0}), Mode=OneWay}" Foreground="#64748B" FontWeight="Normal" />
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,0,3" />

                    <!-- 칸 머리 — 오른쪽 단추 자리(66)만큼 비워 아래 칸과 줄을 맞춘다 -->
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="66" />
                        <ItemsControl ItemsSource="{Binding Headers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#475569" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Width="66">
                                        <Button Content="▲" Command="{Binding MoveUpCommand}" Padding="4,0" FontSize="10" ToolTip="위로"
                                                Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ShowWhenTrue}}" />
                                        <Button Content="▼" Command="{Binding MoveDownCommand}" Padding="4,0" FontSize="10" Margin="1,0" ToolTip="아래로"
                                                Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ShowWhenTrue}}" />
                                        <Button Content="✕" Command="{Binding RemoveCommand}" Padding="4,0" FontSize="10" ToolTip="이 행 지우기"
                                                Visibility="{Binding DataContext.IsList, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ShowWhenTrue}}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ★ 팔레트 — 이 목록은 명부에서 나온다. 여기 적힌 노드 이름이 없다. 카테고리로 묶고 검색칸으로 거른다 -->
        <DockPanel Grid.Column="0" Margin="4">
            <TextBlock DockPanel.Dock="Top" Text="팔레트" FontWeight="Bold" Margin="2" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBox Text="{Binding PaletteSearch, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                <!-- 비었을 때만 보이는 안내 글자 -->
                <TextBlock Text="블록 검색…" Foreground="#9AA5B6" Margin="7,3,0,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaletteSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ListBox ItemsSource="{Binding Palette}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- 묶음 머리 — 캔버스 블록 머리와 같은 카테고리 색 -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Margin="0,6,0,2" Padding="6,2"
                                        Background="{Binding Name, Converter={StaticResource CategoryBrush}}">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Left" Command="{Binding AddCommand}"
                                ToolTip="누르면 캔버스에 추가">
                            <TextBlock Text="{Binding TypeName}" FontWeight="Bold" />
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--
            ★ 캔버스(Nodify). 블록 · 선 · 끌고 있는 선을 각각 틀로 그린다 — 위치 계산은 Nodify 가 한다.
              선은 두 점(포트)의 Anchor 를 따라 그려진다. 우리가 끝점을 계산하지 않는다.
        -->
        <nodify:NodifyEditor x:Name="Canvas" Grid.Column="1" Margin="4" Background="#F6F8FC"
                             ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             PendingConnection="{Binding PendingConnection}"
                             SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                             SelectedConnections="{Binding SelectedConnections}"
                             RemoveConnectionCommand="{Binding DisconnectCommand}">
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="nodify:ItemContainer">
                    <!-- ★ 블록 위치 = 모델 좌표. 끌면 모델이 바뀐다 -->
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="SelectedBrush" Value="#2563EB" />
                    <Setter Property="SelectedBorderThickness" Value="2.5" />
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate>
                    <!-- 머리 = 카테고리 색 · 테두리 = 검증 오류면 빨강 · 바탕 흰색(입력과 출력 수가 달라 남는 칸도) -->
                    <nodify:Node Input="{Binding Input}" Output="{Binding Output}"
                                 Header="{Binding DisplayName}"
                                 HeaderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}"
                                 Background="White" ContentBrush="White" BorderThickness="2"
                                 BorderBrush="{Binding HasError, Converter={StaticResource ErrorBrush}}">
                        <nodify:Node.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold" FontSize="12" Padding="3,1" />
                            </DataTemplate>
                        </nodify:Node.HeaderTemplate>

                        <nodify:Node.InputConnectorTemplate>
                            <DataTemplate>
                                <nodify:NodeInput Header="{Binding Title}" IsConnected="{Binding IsConnected}"
                                                  Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                  Background="White" BorderBrush="#64748B" Foreground="#3F4A5C" FontSize="11" />
                            </DataTemplate>
                        </nodify:Node.InputConnectorTemplate>

                        <nodify:Node.OutputConnectorTemplate>
                            <DataTemplate>
                                <nodify:NodeOutput Header="{Binding Title}" IsConnected="{Binding IsConnected}"
                                                   Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                                   Background="White" BorderBrush="#3B82F6" Foreground="#3F4A5C" FontSize="11" />
                            </DataTemplate>
                        </nodify:Node.OutputConnectorTemplate>

                        <!--
                            ★ 코어에 뚫은 Enabled 가 여기로 나온다.
                              컨텍스트 입력은 끌 대상이 아니라서 체크박스를 아예 숨긴다 —
                              회색으로 두면 "왜 안 눌리지" 를 한 번 더 물어보게 된다.
                        -->
                        <CheckBox Content="끄지 않음" IsChecked="{Binding Enabled}" Margin="2,1" FontSize="11"
                                  Visibility="{Binding IsContext, Converter={StaticResource HideWhenTrue}}" />
                    </nodify:Node>
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate>
                    <!-- 곡선. 더블클릭(또는 Alt+클릭)하면 바로 끊긴다. 한 번 눌러 고른 뒤 Delete 로도 지운다.
                         ★ 끊기는 편집기의 RemoveConnectionCommand 가 받는다 — 그쪽은 '선'을 넘겨 준다.
                           선 자신의 DisconnectCommand 는 '누른 위치(Point)'를 넘겨서 우리 명령이 무시했다.
                         ★ 더블클릭은 OnLineMouseDown 이 직접 본다(이유는 코드 쪽 설명) -->
                    <nodify:Connection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"
                                       Stroke="#8A98B0" StrokeThickness="2.4" Spacing="36" IsSelectable="True"
                                       PreviewMouseLeftButtonDown="OnLineMouseDown" />
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>

            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate>
                    <!-- 점에서 끌기 시작 → 다른 점에 놓으면 잇는다(빈 곳에 놓으면 아무 일도 없다) -->
                    <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                              CompletedCommand="{Binding FinishCommand}"
                                              AllowOnlyConnectors="True" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>
        </nodify:NodifyEditor>

        <Grid Grid.Column="2" Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="120" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ★ 속성폼. ItemsControl 하나가 전부다 — 위 Resources 의 틀이 알아서 고른다 -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold">
                    <Run Text="속성 —" />
                    <Run Text="{Binding SelectedNode.DisplayName, Mode=OneWay}" />
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 입구 블록을 고르면 무엇이 들어오는지 한 줄(없으면 빈 글자) -->
                        <TextBlock Text="{Binding SelectedHint}" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0" />
                        <!-- 낱개 값 — 서술자에서 -->
                        <ItemsControl ItemsSource="{Binding SelectedNode.Fields}" />
                        <!-- 목록 · 묶음 값 — 표(ListParams)에서. 입구 블록이면 그 입구로 들어가는 값 -->
                        <ItemsControl ItemsSource="{Binding SelectedLists}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ★ 검증 — 저장할 때가 아니라 고치는 순간 여기가 바뀐다. 오류가 가리키는 블록은 캔버스에서 빨간 테두리 -->
            <GroupBox Grid.Row="1" Header="검증" Margin="0,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ValidationMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <!--
                ★ 탭마다 다른 것을 끼우는 자리 — die 탭은 미리보기. 높이는 끼우는 쪽이 정한다(안 끼우면 칸이 없다).
                  웨이퍼 에디터 탭은 실행 칸이 넓어야 해서(맵 + 결함 표) 여기가 아니라 편집기 아래에 둔다.
                  편집기는 여기에 무엇이 오는지 모른다.
            -->
            <ContentPresenter Grid.Row="2" Margin="0,6"
                              Content="{Binding SideContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Grid>
</UserControl>
