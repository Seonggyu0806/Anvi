<Window x:Class="DiePipeline.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiePipeline.Wpf.ViewModels"
        xmlns:views="clr-namespace:DiePipeline.Wpf.Views"
        xmlns:conv="clr-namespace:DiePipeline.Wpf.Converters"
        xmlns:wexec="clr-namespace:DiePipeline.Wafer.Execution;assembly=DiePipeline.Wafer"
        Title="DiePipeline 블록 에디터" Height="860" Width="1360">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:WaferMapStateToBrushConverter x:Key="MapBrush" />

        <!-- 맵의 수동 제외 칸 — 회색 빗금(검사하지 않은 die 지만 원판 밖과 다르다) -->
        <DrawingBrush x:Key="ExcludedHatch" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#E5E7EB" Geometry="M0,0 H6 V6 H0 Z" />
                    <GeometryDrawing Geometry="M0,6 L6,0">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#9CA3AF" Thickness="1.2" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <BooleanToVisibilityConverter x:Key="ShowWhenTrue" />
        <conv:WorkspaceToCheckedConverter x:Key="WorkspaceChecked" />
        <conv:WorkspaceToVisibilityConverter x:Key="WorkspaceVisible" />
        <conv:InverseBoolToVisibilityConverter x:Key="HideWhenTrue" />

        <!--
            오버레이 결함 네모 — 다이 · 웨이퍼 오버레이가 같이 쓴다. 누르면 그 결함을 고르고, 골라지면 노랗게 칠한다.
            ★ 선 두께 · 글자 크기는 오버레이 주인(ItemsControl 의 DataContext)이 원본 픽셀로 정한다 — 그림 크기가 제각각이라.
        -->
        <DataTemplate x:Key="OverlayBoxTemplate">
            <Button Command="{Binding SelectCommand}" ToolTip="{Binding Tooltip}" Cursor="Hand"
                    Width="{Binding Width}" Height="{Binding Height}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Rectangle x:Name="Box" Stroke="#E53935"
                               StrokeThickness="{Binding DataContext.OverlayLine, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    <TextBlock Text="{Binding Label}" Foreground="#FFD740" FontWeight="Bold"
                               FontSize="{Binding DataContext.OverlayLabelSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Box" Property="Stroke" Value="#FFD740" />
                    <Setter TargetName="Box" Property="Fill" Value="#55FFD740" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            작업공간 바 — 교수님 앱과 같은 모양: 묶음 이름(진한 글자) + 칸 단추, 묶음 사이는 얇은 세로선.
            고른 칸 = 얇은 테두리 + 2px 떠오름(배경색 없이). 떠오름은 RenderTransform 이라 옆 단추가 밀리지 않는다.
        -->
        <Style x:Key="WorkspaceGroupCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#232320" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="WorkspaceGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DEDBD2" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="0,3,18,3" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="WorkspaceSegment" TargetType="RadioButton">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#232320" />
            <Setter Property="GroupName" Value="workspace" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#DCD8CE" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#55524B" />
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--
        ★ 작업공간 — 탭 대신 맨 위 바(교수님 앱과 같다). 칸은 전부 떠 있고 고른 칸만 보인다.
          웨이퍼 · 옵션 검사는 다이 · 블록 에디터의 레시피를 그대로 쓴다 — 거기서 고치면 옵션 검사도 같이 바뀐다.
    -->
    <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E2E2" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Margin="14,8">
            <Border Style="{StaticResource WorkspaceGroup}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource WorkspaceGroupCaption}" Text="다이" />
                    <RadioButton Style="{StaticResource WorkspaceSegment}" Content="블록 에디터"
                                 IsChecked="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceChecked}, ConverterParameter={x:Static vm:Workspace.DieEditor}}" />
                    <RadioButton Style="{StaticResource WorkspaceSegment}" Content="오버레이"
                                 IsChecked="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceChecked}, ConverterParameter={x:Static vm:Workspace.DieOverlay}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WorkspaceGroup}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource WorkspaceGroupCaption}" Text="웨이퍼" />
                    <RadioButton Style="{StaticResource WorkspaceSegment}" Content="블록 에디터"
                                 IsChecked="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceChecked}, ConverterParameter={x:Static vm:Workspace.WaferEditor}}" />
                    <RadioButton Style="{StaticResource WorkspaceSegment}" Content="오버레이"
                                 IsChecked="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceChecked}, ConverterParameter={x:Static vm:Workspace.WaferOverlay}}" />
                    <RadioButton Style="{StaticResource WorkspaceSegment}" Content="옵션 검사"
                                 ToolTip="레시피 파일 없이 입력칸(격자 · 원판 · 정렬 · 수동 지정)으로 검사 — 다이 블록 에디터의 레시피를 쓴다"
                                 IsChecked="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceChecked}, ConverterParameter={x:Static vm:Workspace.WaferOptions}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource WorkspaceGroup}" BorderThickness="0" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource WorkspaceGroupCaption}" Text="원본" />
                    <RadioButton Style="{StaticResource WorkspaceSegment}" Content="이미지 뷰어"
                                 IsChecked="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceChecked}, ConverterParameter={x:Static vm:Workspace.Viewer}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

    <Grid>

    <!-- ═════════════════════════ 다이 · 블록 에디터 ═════════════════════════ -->
    <DockPanel Visibility="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceVisible}, ConverterParameter={x:Static vm:Workspace.DieEditor}}">
        <!--
            ★ 단축키 — die 탭 안에서만 듣는다(창 전체에 걸면 웨이퍼 탭에서 눌러도 die 그래프가 바뀐다).
              입력칸에서 글자를 지우는 Delete 는 입력칸이 먼저 받으므로 블록이 지워지지 않는다.
        -->
        <DockPanel.InputBindings>
            <KeyBinding Modifiers="Control" Key="Z" Command="{Binding Editor.UndoCommand}" />
            <KeyBinding Modifiers="Control" Key="Y" Command="{Binding Editor.RedoCommand}" />
            <KeyBinding Modifiers="Control" Key="D" Command="{Binding Editor.DuplicateSelectedCommand}" />
            <KeyBinding Key="Delete" Command="{Binding Editor.DeleteSelectedCommand}" />
        </DockPanel.InputBindings>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="표준 불러오기" Command="{Binding Editor.NewStandardCommand}" />
                <Button Content="열기…" Command="{Binding Editor.ImportCommand}" />
                <Button Content="내보내기…" Command="{Binding Editor.ExportCommand}" />
                <Separator />
                <Button Content="↶ 되돌리기" Command="{Binding Editor.UndoCommand}" ToolTip="Ctrl+Z" />
                <Button Content="↷ 다시" Command="{Binding Editor.RedoCommand}" ToolTip="Ctrl+Y" />
                <Separator />
                <Button Content="선택 블록 복제" Command="{Binding Editor.DuplicateSelectedCommand}" ToolTip="Ctrl+D" />
                <Button Content="선택 삭제" Command="{Binding Editor.DeleteSelectedCommand}"
                        ToolTip="Delete — 고른 선이 있으면 선을, 없으면 고른 블록을 지운다" />
                <Button Content="전체 보기" Command="{Binding Editor.FitCommand}" ToolTip="그래프 전체가 보이게 맞춘다" />
                <Separator />
                <Button Content="미리보기 실행" Command="{Binding RunPreviewCommand}" FontWeight="Bold" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="검증:" />
                    <Run Text="{Binding Editor.IsValid, Mode=OneWay}" />
                    <Run Text="  |  " />
                    <Run Text="{Binding Editor.StatusText, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!--
            ★ 편집기(팔레트 · 캔버스 · 속성 · 검증)는 웨이퍼 편집 탭과 같은 부품이다.
              die 탭에만 있는 것 — 미리보기 — 은 오른쪽 아래 칸(SideContent)에 끼운다.
              ★ 끼운 칸의 DataContext 는 편집기가 아니라 창(MainViewModel)이다 — 미리보기는 die 탭의 일이다.
        -->
        <views:GraphEditorView DataContext="{Binding Editor}">
            <views:GraphEditorView.SideContent>
                <!--
                    ★ 미리보기 — 칠판의 중간 이미지를 실행 순서대로 늘어놓는다.
                      "어느 단계에서 결함이 사라졌나" 를 눈으로 짚는 게 목적이다.
                -->
                <GroupBox Height="250" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run Text="미리보기 —" />
                            <Run Text="{Binding PreviewSummary, Mode=OneWay}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DockPanel>
                        <!-- 입력 = 합성 견본 또는 원본 뷰어에서 넘겨받은 ROI · 정상 die. 원본이면 되돌리기 단추. 칸이 좁아 줄을 바꾼다 -->
                        <DockPanel DockPanel.Dock="Top" Margin="2,2,2,4">
                            <Button DockPanel.Dock="Right" Content="합성으로 되돌리기" Command="{Binding UseSyntheticCommand}" Margin="6,0,0,0" Padding="4,0"
                                    VerticalAlignment="Top" Visibility="{Binding IsOriginalPreview, Converter={StaticResource ShowWhenTrue}}" />
                            <TextBlock TextWrapping="Wrap" Foreground="Gray">
                                <Run Text="입력:" />
                                <Run Text="{Binding PreviewSourceText, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <TabControl>
                            <TabItem Header="단계별">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding PreviewItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 더블클릭 → 이 단계 그림을 배경으로 다이 오버레이 -->
                                                <StackPanel Margin="4" Width="96" Background="Transparent" Cursor="Hand"
                                                            ToolTip="더블클릭 — 오버레이에서 크게"
                                                            MouseLeftButtonDown="OnThumbnailMouseDown">
                                                    <TextBlock Text="{Binding Key}" FontSize="10"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                                    <Image Source="{Binding Image}" Height="96" Stretch="Uniform" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="결함">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        ★★ 좌표를 다시 계산하지 않는다.
                                          Viewbox 안에 '원본 픽셀 크기' 판을 깔고, 그 위에 결함 좌표를 그대로 얹는다.
                                          확대·축소는 Viewbox 가 통째로 해 준다 — 배율 곱셈이 코드에 한 줄도 없다.
                                          화면이 좌표를 직접 환산하기 시작하면 아래층과 어긋나는 날이 반드시 온다.
                                    -->
                                    <Viewbox Grid.Column="0" Stretch="Uniform" Margin="4" MaxWidth="200">
                                        <Grid Width="{Binding InspectedWidth}" Height="{Binding InspectedHeight}">
                                            <Image Source="{Binding Inspected}" Stretch="Fill" />

                                            <ItemsControl ItemsSource="{Binding Defects}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="{Binding Bounds.Width}"
                                                                   Height="{Binding Bounds.Height}"
                                                                   Stroke="#E53935" StrokeThickness="0.4" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Viewbox>

                                    <!-- 결함 목록 — Defect 를 그대로 바인딩한다 -->
                                    <DataGrid Grid.Column="1" ItemsSource="{Binding Defects}" Margin="4"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              FontSize="11">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="36" />
                                            <DataGridTextColumn Header="위치" Binding="{Binding Bounds}" Width="*" />
                                            <DataGridTextColumn Header="면적" Binding="{Binding Area}" Width="52" />
                                            <DataGridTextColumn Header="밝기"
                                                                Binding="{Binding MeanIntensity, StringFormat=F2}"
                                                                Width="48" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </GroupBox>
            </views:GraphEditorView.SideContent>
        </views:GraphEditorView>
    </DockPanel>

    <!-- ═════════════════════════ 다이 · 오버레이 ═════════════════════════ -->
    <!--
        ★ 미리보기 결과를 크게 — 배경(검사 조각 · 단계 그림) 위에 결함 네모. 미리보기를 따로 돌리지 않고 블록 에디터의 결과를 그대로 쓴다.
          그림 크기(원본 픽셀)의 판에 배경을 늘여 깔고 네모를 좌표 그대로 얹는다 — 늘이고 줄이는 건 Viewbox.
    -->
    <Grid Visibility="{Binding SelectedWorkspace, Converter={StaticResource WorkspaceVisible}, ConverterParameter={x:Static vm:Workspace.DieOverlay}}" Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="340" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,6">
                <TextBlock Text="배경:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding OverlayBackgrounds}" SelectedItem="{Binding SelectedOverlayBackground}"
                          DisplayMemberPath="Key" MinWidth="160" />
                <TextBlock Text="{Binding PreviewSummary}" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" />
            </StackPanel>

            <Grid>
                <TextBlock Text="다이 · 블록 에디터에서 '미리보기 실행' 을 누르면 결과가 여기에 크게 보입니다"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                           Visibility="{Binding HasPreview, Converter={StaticResource HideWhenTrue}}" />
                <Border Background="#1E2630" ClipToBounds="True"
                        Visibility="{Binding HasPreview, Converter={StaticResource ShowWhenTrue}}">
                    <Viewbox Stretch="Uniform" Margin="6">
                        <Grid Width="{Binding InspectedWidth}" Height="{Binding InspectedHeight}">
                            <Image Source="{Binding SelectedOverlayBackground.Image}" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <ItemsControl ItemsSource="{Binding DefectBoxes}" ItemTemplate="{StaticResource OverlayBoxTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E7EB" />

        <!-- 결함 목록 — 고르면 네모가 강조되고, 네모를 누르면 여기 줄이 골라진다.
             위에 보고서(CSV · JSON — 원본 입력이면 뷰어의 µm/px 로 환산, 레포 안이면 거부) -->
        <GroupBox Grid.Column="2" Header="결함">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,4">
                    <Button Content="결함 보고서…" Command="{Binding ExportReportCommand}" HorizontalAlignment="Left" Padding="6,1"
                            ToolTip="CSV 또는 JSON(확장자로 고른다) — px 값 + µm 환산. 원본 입력일 때만 뷰어의 µm/px, 합성 견본은 미보정. 레포 밖에만" />
                    <TextBlock Text="{Binding ReportText}" TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Defects}" SelectedItem="{Binding SelectedDefect}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="36" />
                        <DataGridTextColumn Header="위치" Binding="{Binding Bounds}" Width="*" />
                        <DataGridTextColumn Header="면적" Binding="{Binding Area}" Width="52" />
                        <DataGridTextColumn Header="밝기" Binding="{Binding MeanIntensity, StringFormat=F2}" Width="48" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>

    <!-- ═════════════════════════ 웨이퍼 · 블록 에디터 ═════════════════════════ -->
    <!--
        ★ 웨이퍼 레시피(*.wafer.json)를 블록으로 짜고 그 자리에서 돌린다. 편집기는 die 탭과 같은 부품.
          세부 값(격자 · 정렬 기준 등)은 블록을 눌렀을 때만 오른쪽 속성 칸에 나온다 — 캔버스는 흐름만.
    -->
    <!-- ★ DataContext 를 웨이퍼 에디터로 바꾸므로, 보이기는 창(MainViewModel)의 값을 직접 본다(교수님 앱과 같은 함정) -->
    <DockPanel DataContext="{Binding WaferEditor}"
               Visibility="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WorkspaceVisible}, ConverterParameter={x:Static vm:Workspace.WaferEditor}}">
        <!-- 단축키 — 이 탭 안에서만(die 탭과 같은 키, 이 탭의 편집기에) -->
        <DockPanel.InputBindings>
            <KeyBinding Modifiers="Control" Key="Z" Command="{Binding Editor.UndoCommand}" />
            <KeyBinding Modifiers="Control" Key="Y" Command="{Binding Editor.RedoCommand}" />
            <KeyBinding Modifiers="Control" Key="D" Command="{Binding Editor.DuplicateSelectedCommand}" />
            <KeyBinding Key="Delete" Command="{Binding Editor.DeleteSelectedCommand}" />
        </DockPanel.InputBindings>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="견본 불러오기" Command="{Binding Editor.NewStandardCommand}"
                        ToolTip="합성 견본 레시피(samples/wafer/demo.wafer.json)를 다시 연다" />
                <Button Content="열기…" Command="{Binding Editor.ImportCommand}" />
                <Button Content="내보내기…" Command="{Binding Editor.ExportCommand}"
                        ToolTip="다른 폴더에 저장하면 안의 경로를 새 폴더 기준으로 고쳐 적는다" />
                <Separator />
                <Button Content="↶ 되돌리기" Command="{Binding Editor.UndoCommand}" ToolTip="Ctrl+Z" />
                <Button Content="↷ 다시" Command="{Binding Editor.RedoCommand}" ToolTip="Ctrl+Y" />
                <Separator />
                <Button Content="선택 블록 복제" Command="{Binding Editor.DuplicateSelectedCommand}" ToolTip="Ctrl+D" />
                <Button Content="선택 삭제" Command="{Binding Editor.DeleteSelectedCommand}"
                        ToolTip="Delete — 고른 선이 있으면 선을, 없으면 고른 블록을 지운다" />
                <Button Content="전체 보기" Command="{Binding Editor.FitCommand}" ToolTip="그래프 전체가 보이게 맞춘다" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="검증:" />
                    <Run Text="{Binding Editor.IsValid, Mode=OneWay}" />
                    <Run Text="  |  " />
                    <Run Text="{Binding Editor.StatusText, Mode=OneWay}" />
                    <Run Text="  |  레시피 파일:" />
                    <Run Text="{Binding Editor.FilePath, Mode=OneWay, TargetNullValue=(저장 안 함)}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <!-- 위 블록 그래프 : 아래 실행 칸 = 반반 — 창을 키우면 실행 칸(맵)도 같이 커진다. 경계는 끌어서 바꾼다 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <views:GraphEditorView Grid.Row="0" DataContext="{Binding Editor}" />

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#E5E7EB" />

            <!-- ── 실행 칸: 사진 → ▶ 실행 → 요약 · 칸 지도 · 결함 표. 명령행 wafer 의 레시피 실행과 같은 실행기 ── -->
            <GroupBox Grid.Row="2" Header="실행" Margin="4,2,4,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2">
                        <Button Content="합성 견본 그리기" Command="{Binding DrawSampleCommand}" Padding="8,2"
                                ToolTip="명령행 demo 와 같은 그림 — 견본 레시피와 짝" />
                        <Button Content="사진 열기…" Command="{Binding OpenImageCommand}" Padding="8,2" Margin="4,0" />
                        <TextBlock Text="{Binding ImageText}" VerticalAlignment="Center" Margin="6,0" Foreground="#475569" />
                        <Button Content="▶ 실행" Command="{Binding RunCommand}" Padding="12,2" Margin="12,0,4,0" FontWeight="Bold" />
                        <Button Content="취소" Command="{Binding CancelCommand}" Padding="8,2" />
                        <!-- 실행 단계 — 정렬 중 → die n / N → 완료(경과 초). 막대는 실행 중에만 -->
                        <ProgressBar Width="160" Height="12" Margin="12,0,6,0" VerticalAlignment="Center"
                                     Maximum="{Binding DieTotal}" Value="{Binding DiesDone, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource ShowWhenTrue}}" />
                        <TextBlock Text="{Binding StageText}" VerticalAlignment="Center" Foreground="#1D4ED8" FontWeight="Bold" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,2">
                        <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" />
                        <TextBlock Text="{Binding AlignmentText}" Foreground="#475569" />
                        <TextBlock Text="레시피가 바뀌었습니다 — 아래 결과는 바뀌기 전 레시피의 것입니다. ▶ 실행을 다시 누르세요"
                                   Foreground="#B45309"
                                   Visibility="{Binding IsStale, Converter={StaticResource ShowWhenTrue}}" />
                        <!-- 멈춘 까닭 · 경고 — 없으면 빈 글자 -->
                        <TextBlock Text="{Binding NoteText}" Foreground="#B91C1C" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 칸 지도 — die 하나가 칸 하나. 색 = 상태, 숫자 = 결함 수(샘플링 전), '!' = 검사가 터진 die, '×' = 수동 제외.
                             실행 중에는 die 가 끝날 때마다 칠해진다. 칸을 누르면 그 die 를 고른다 → 다이 미리보기.
                             ★ 칸 칸이 많은 원판도 한눈에 — 자리에 맞게 줄인다(키우지는 않는다) -->
                        <DockPanel Grid.Column="0">
                            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="6,1" Margin="0,0,0,4"
                                    Content="{Binding PreviewDieText}" Command="{Binding PreviewDieCommand}"
                                    ToolTip="고른 die 를 다이 블록 에디터에서 러너와 같은 ROI · 골든으로 미리보기 — 값을 고치면 바로 다시 검사" />
                            <!-- 범례 — 교수님 맵과 같은 짝(E1 연두/분홍 · E0 청회/주황) + 대기 · 제외 · 터짐 -->
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                <WrapPanel.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="11" />
                                        <Setter Property="Height" Value="11" />
                                        <Setter Property="CornerRadius" Value="2" />
                                        <Setter Property="Margin" Value="0,0,3,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10" />
                                        <Setter Property="Foreground" Value="#6B7280" />
                                        <Setter Property="Margin" Value="0,0,8,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Border Background="{Binding Source={x:Static wexec:WaferMapState.E1}, Converter={StaticResource MapBrush}}" /><TextBlock Text="E1" />
                                <Border Background="{Binding Source={x:Static wexec:WaferMapState.Defective}, Converter={StaticResource MapBrush}}" /><TextBlock Text="E1 결함" />
                                <Border Background="{Binding Source={x:Static wexec:WaferMapState.E0}, Converter={StaticResource MapBrush}}" /><TextBlock Text="E0" />
                                <Border Background="{Binding Source={x:Static wexec:WaferMapState.E0Defective}, Converter={StaticResource MapBrush}}" /><TextBlock Text="E0 결함" />
                                <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" /><TextBlock Text="대기" />
                                <Border Background="{StaticResource ExcludedHatch}" /><TextBlock Text="제외" />
                                <Border Background="{Binding Source={x:Static wexec:WaferMapState.Failed}, Converter={StaticResource MapBrush}}" /><TextBlock Text="터짐" />
                            </WrapPanel>
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ListBox ItemsSource="{Binding MapCells}" SelectedItem="{Binding SelectedCell}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding MapCols}" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <!-- 고른 칸은 파란 테두리 — 칸 안쪽에 그려 옆 칸과 붙어 보이지 않게. 기본 고름 색은 칸 색을 가려서 쓰지 않는다 -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid>
                                                            <ContentPresenter />
                                                            <Border x:Name="Pick" Margin="2" BorderThickness="2" BorderBrush="Transparent" CornerRadius="2" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Pick" Property="BorderBrush" Value="#2563EB" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 칸 사이 4 px. 대기 칸은 흰 바탕 + 회색 테두리, 수동 제외는 빗금 -->
                                            <Border Width="26" Height="26" Margin="2" CornerRadius="2" BorderThickness="1" ToolTip="{Binding Tip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding State, Converter={StaticResource MapBrush}}" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                                <Setter Property="BorderBrush" Value="#94A3B8" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Excluded">
                                                                <Setter Property="Background" Value="{StaticResource ExcludedHatch}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Viewbox>
                        </DockPanel>

                        <!-- 결함 표 — 샘플링 후(보여 줄 것). 웨이퍼 좌표는 정렬을 적용한 절대 좌표 -->
                        <DataGrid Grid.Column="1" ItemsSource="{Binding Defects}" SelectedItem="{Binding SelectedDefect}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="11" Margin="6,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="열" Binding="{Binding DieCol}" Width="36" />
                                <DataGridTextColumn Header="행" Binding="{Binding DieRow}" Width="36" />
                                <DataGridTextColumn Header="존" Binding="{Binding Zone}" Width="40" />
                                <DataGridTextColumn Header="#" Binding="{Binding Defect.Id}" Width="36" />
                                <DataGridTextColumn Header="웨이퍼 X" Binding="{Binding AbsX, StringFormat=F1}" Width="70" />
                                <DataGridTextColumn Header="웨이퍼 Y" Binding="{Binding AbsY, StringFormat=F1}" Width="70" />
                                <DataGridTextColumn Header="면적" Binding="{Binding Defect.Area}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>

    <!-- ═════════════════════════ 웨이퍼 · 오버레이 ═════════════════════════ -->
    <!--
        ★ 웨이퍼 에디터의 마지막 실행을 개요 그림 위에 — die 테두리(맵과 같은 색) + 결함 네모(개요 기준 최소 8 px).
          좌표는 전부 원본 픽셀. 개요 그림을 원본 크기 판에 늘여 깔고 그대로 얹는다(다이 오버레이와 같은 수법).
    -->
    <Grid DataContext="{Binding WaferEditor}" Margin="6"
          Visibility="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WorkspaceVisible}, ConverterParameter={x:Static vm:Workspace.WaferOverlay}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="400" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                <TextBlock Text="{Binding SummaryText}" FontWeight="Bold" />
                <TextBlock Text="{Binding ImageText}" Foreground="Gray" />
                <TextBlock Text="레시피가 바뀌었습니다 — 아래 결과는 바뀌기 전 레시피의 것입니다"
                           Foreground="#B45309" Visibility="{Binding IsStale, Converter={StaticResource ShowWhenTrue}}" />
            </StackPanel>

            <Grid>
                <TextBlock Text="웨이퍼 · 블록 에디터에서 '▶ 실행' 을 누르면 결과가 여기에 그림으로 보입니다"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"
                           Visibility="{Binding HasResult, Converter={StaticResource HideWhenTrue}}" />
                <Border Background="#1E2630" ClipToBounds="True"
                        Visibility="{Binding HasResult, Converter={StaticResource ShowWhenTrue}}">
                    <Viewbox Stretch="Uniform" Margin="6">
                        <Grid Width="{Binding ImageWidth}" Height="{Binding ImageHeight}">
                            <Image Source="{Binding OverviewImage}" Stretch="Fill" />

                            <!-- die 테두리 — 색 = 맵 칸 상태 -->
                            <ItemsControl ItemsSource="{Binding OverlayDies}" IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Area.X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Area.Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="{Binding Area.Width}" Height="{Binding Area.Height}"
                                                   Stroke="{Binding State, Converter={StaticResource MapBrush}}"
                                                   StrokeThickness="{Binding DataContext.OverlayLine, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 결함 네모 — 누르면 그 결함을 고른다 -->
                            <ItemsControl ItemsSource="{Binding DefectBoxes}" ItemTemplate="{StaticResource OverlayBoxTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E7EB" />

        <!-- 결함 목록 — 실행 칸의 결함 표와 같은 목록 · 같은 고름. 줄 더블클릭 = 원본에서 보기 -->
        <GroupBox Grid.Column="2" Header="결함(샘플링 후)">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="원본에서 보기" HorizontalAlignment="Left" Margin="0,2,0,4" Padding="6,1"
                        Command="{Binding DataContext.ShowDefectInViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="원본 이미지 뷰어에서 고른 결함 자리를 100% 로 — 결함 전부 빨강 · 고른 것 노랑(줄 더블클릭과 같다)" />
                <DataGrid ItemsSource="{Binding Defects}" SelectedItem="{Binding SelectedDefect}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11"
                          MouseDoubleClick="OnWaferDefectDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="열" Binding="{Binding DieCol}" Width="36" />
                        <DataGridTextColumn Header="행" Binding="{Binding DieRow}" Width="36" />
                        <DataGridTextColumn Header="존" Binding="{Binding Zone}" Width="40" />
                        <DataGridTextColumn Header="#" Binding="{Binding Defect.Id}" Width="36" />
                        <DataGridTextColumn Header="웨이퍼 X" Binding="{Binding AbsX, StringFormat=F1}" Width="70" />
                        <DataGridTextColumn Header="웨이퍼 Y" Binding="{Binding AbsY, StringFormat=F1}" Width="70" />
                        <DataGridTextColumn Header="면적" Binding="{Binding Defect.Area}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>

    <!-- ═════════════════════════ 원본 · 이미지 뷰어 ═════════════════════════ -->
    <!-- ★ DataContext 를 뷰어로 바꾸므로, 보이기는 창(MainViewModel)의 값을 직접 본다 -->
    <views:ImageViewerView DataContext="{Binding Viewer}"
                           Visibility="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WorkspaceVisible}, ConverterParameter={x:Static vm:Workspace.Viewer}}" />

    <!-- ═════════════════════════ 웨이퍼 · 옵션 검사(이전 '웨이퍼' 탭) ═════════════════════════ -->
        <Grid DataContext="{Binding Wafer}"
              Visibility="{Binding DataContext.SelectedWorkspace, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WorkspaceVisible}, ConverterParameter={x:Static vm:Workspace.WaferOptions}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- ── 왼쪽: 올리기 · 격자 · 검사 ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <GroupBox Header="합성 웨이퍼 (demo 명령과 같은 그림)" Padding="4">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <TextBlock Text="열" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SynCols}" Margin="0,1" />
                                <TextBlock Text="행" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SynRows}" Margin="0,1" />
                                <TextBlock Text="피치(px)" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SynPitch}" Margin="0,1" />
                                <TextBlock Text="결함 수" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SynDefects}" Margin="0,1" />
                                <TextBlock Text="기울기(°)" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SynAngle}" Margin="0,1" />
                                <TextBlock Text="씨" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SynSeed}" Margin="0,1" />
                            </UniformGrid>
                            <CheckBox Content="원판으로 그리기 (원판 밖을 어둡게)" IsChecked="{Binding SynRound}" Margin="0,4,0,0" />
                            <Button Content="그리기" Command="{Binding DrawCommand}" Margin="0,4,0,0" />
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="기울기 0.05° 넘으면 warp read 가 없어 멈추고, 2° 넘으면 정렬을 못 믿어 멈춘다 — 둘 다 직접 보려고 둔 칸이다." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="이미지 파일" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <Button Content="열기…" Command="{Binding OpenCommand}" />
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="통째로 읽지 않는다 — die 를 볼 때 그 칸과 이웃만 뜯어 온다. 정렬은 아래 '표식 정렬' 칸에서." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="격자" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <TextBlock Text="열" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridCols}" Margin="0,1" />
                                <TextBlock Text="행" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridRows}" Margin="0,1" />
                                <TextBlock Text="피치(px)" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridPitch}" Margin="0,1" />
                                <TextBlock Text="die(0,0) x" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridOriginX}" Margin="0,1" />
                                <TextBlock Text="die(0,0) y" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridOriginY}" Margin="0,1" />
                                <TextBlock Text="원판 x" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridCircleX}" Margin="0,1" />
                                <TextBlock Text="원판 y" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridCircleY}" Margin="0,1" />
                                <TextBlock Text="원판 반지름" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridCircleRadius}" Margin="0,1" />
                                <TextBlock Text="가장자리 여유" VerticalAlignment="Center" />
                                <TextBox Text="{Binding GridEdgeExclusion}" Margin="0,1" />
                            </UniformGrid>
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="die(0,0) 자리 — 표식으로 정렬하면 '대략 자리'로 쓰고 정렬이 정확히 고친다(피치의 절반 안이어야 die 번호가 맞는다). 합성은 0 이면 된다." />
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="원판은 사진 좌표 · 반지름 0 = 원판 안 씀(사각형 웨이퍼). 합성 원판은 그리면 채워지고, 파일을 열면 비워진다. 가장자리 여유(px)만큼은 안 본다 — 원을 맞춘 오차·노치를 가린다." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="표식 정렬 — 웨이퍼가 놓인 자리를 찾는다" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding MarkText}" TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <Button Content="표식 열기…" Command="{Binding OpenMarkCommand}" Margin="0,0,2,0" />
                                <Button Content="빼기" Command="{Binding ClearMarkCommand}" Margin="2,0,0,0" />
                            </UniformGrid>
                            <TextBlock Text="표식 위치 (x,y; x,y)" Margin="0,4,0,0" />
                            <TextBox Text="{Binding MarkExpect}" Margin="0,1" />
                            <UniformGrid Columns="2" Margin="0,2,0,0">
                                <TextBlock Text="찾는 범위(px)" VerticalAlignment="Center" />
                                <TextBox Text="{Binding MarkPadding}" Margin="0,1" />
                            </UniformGrid>
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="명령행 --mark · --expect · --mark-padding 과 같다. 표식 위치는 die(0,0) 을 (0,0) 으로 본 설계 좌표로 2개 이상. 찾는 범위 0 = 사진 전체(원판 원본은 통째로 못 읽으니 꼭 준다)." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="사람이 정하는 die (수동 지정)" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBox Text="{Binding ZoneText}" Margin="0,1" />
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="열,행=E1|E0|off 를 ; 로 이어 적는다 (예: 2,3=off; 3,3=off). 자동 판정 뒤에 덮어쓴다 — 노치처럼 원 판정이 틀리는 die 에. off 는 die 전체를 검사에서 뺀다." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="E0 레시피 — 가장자리 (골든 없음)" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding E0Text}" TextWrapping="Wrap" />
                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <Button Content="열기…" Command="{Binding OpenE0Command}" Margin="0,0,2,0" />
                                <Button Content="빼기" Command="{Binding ClearE0Command}" Margin="2,0,0,0" />
                            </UniformGrid>
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="die 탭 그래프는 E1 로 쓴다. 원판이면 걸친 칸이 원판 밖까지 찍혀 있으니 원판 밖을 가리는 레시피(samples/recipes/die.dark.masked.json)를 연다." />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="이웃 — 골든 고르기" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <CheckBox Content="가까운 순서로 (최대 3장)" IsChecked="{Binding UseNearest}" />
                            <TextBlock FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="안 고르면 같은 행 좌우 1칸(최대 2장). 레시피가 요구하는 장수와 짝이 안 맞으면 die 가 '검사 실패' 로 남는다." />
                        </StackPanel>
                    </GroupBox>

                    <Button Content="▶ 검사" Command="{Binding InspectCommand}" FontWeight="Bold" Height="32" Margin="0,10,0,0" />
                    <Button Content="멈춤" Command="{Binding CancelCommand}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── 가운데: 웨이퍼 위에 맵 ── -->
            <DockPanel Grid.Column="1" Margin="4">
                <TextBlock DockPanel.Dock="Top" Text="{Binding SceneTitle}" FontWeight="Bold" Margin="2,0,0,4" />

                <!-- 범례 — 색이 무엇을 뜻하는지 화면이 직접 말한다 -->
                <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,6,0,0">
                    <Rectangle Width="14" Height="14" Stroke="#43A047" Fill="#2243A047" StrokeThickness="2" />
                    <TextBlock Text=" 깨끗함   " VerticalAlignment="Center" />
                    <Rectangle Width="14" Height="14" Stroke="#E53935" Fill="#33E53935" StrokeThickness="2" />
                    <TextBlock Text=" 결함 있음   " VerticalAlignment="Center" />
                    <Rectangle Width="14" Height="14" Stroke="#78909C" Fill="#2278909C" StrokeThickness="2" />
                    <TextBlock Text=" E0 깨끗함   " VerticalAlignment="Center" />
                    <Rectangle Width="14" Height="14" Stroke="#FB8C00" Fill="#33FB8C00" StrokeThickness="2" />
                    <TextBlock Text=" E0 결함   " VerticalAlignment="Center" />
                    <Rectangle Width="14" Height="14" Stroke="#424242" Fill="#AA616161" StrokeThickness="2" />
                    <TextBlock Text=" × 검사 실패 — 안 본 것   " VerticalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Text="빈칸 = 원판 밖(die 아님)   " VerticalAlignment="Center" Foreground="Gray" />
                    <Rectangle Width="14" Height="14" Stroke="#1E88E5" StrokeThickness="2" />
                    <TextBlock Text=" 선택" VerticalAlignment="Center" />
                </WrapPanel>

                <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1">
                    <!--
                        ★★ die 탭 결함 오버레이와 같은 수법 — 좌표를 다시 계산하지 않는다.
                          원본 픽셀 크기의 판을 깔고, die 칸(Roi)과 결함(Bounds)을 적힌 좌표 그대로 얹는다.
                          미리보기 그림은 솎아 낸 것이라도 판 크기로 늘여 붙이니 칸이 안 어긋난다.
                    -->
                    <Viewbox Stretch="Uniform" Margin="6">
                        <Grid Width="{Binding SceneWidth}" Height="{Binding SceneHeight}">
                            <Image Source="{Binding Overview}" Stretch="Fill" />

                            <ListBox ItemsSource="{Binding Dies}" SelectedItem="{Binding SelectedDie}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Canvas.Left" Value="{Binding Roi.X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Roi.Y}" />
                                        <!-- 기본 테두리·여백을 걷어 낸다 — 남으면 칸이 몇 픽셀씩 밀린다 -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <!-- ★ 원판 밖 — die 가 아니다. 칸을 아예 안 그린다(누를 수도 없다) -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OffWafer}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Roi.Width}" Height="{Binding Roi.Height}"
                                              Background="Transparent" Cursor="Hand" ToolTip="{Binding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="3*" />
                                            </Grid.RowDefinitions>

                                            <!--
                                                ★★ 칸 색은 Summary.State 로만 정한다 — DefectCount 로 정하면
                                                  터진 die(0개)가 깨끗한 die 와 같은 색이 된다. 5주차에 막은 그 구멍이다.
                                            -->
                                            <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                       StrokeThickness="{Binding DataContext.StrokePx, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Stroke" Value="#9E9E9E" />
                                                        <Setter Property="Fill" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Summary.State}" Value="Clean">
                                                                <Setter Property="Stroke" Value="#43A047" />
                                                                <Setter Property="Fill" Value="#2243A047" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Summary.State}" Value="Defective">
                                                                <Setter Property="Stroke" Value="#E53935" />
                                                                <Setter Property="Fill" Value="#33E53935" />
                                                            </DataTrigger>
                                                            <!-- E0(가장자리) — 교수님 맵처럼 청회, 결함이면 주황 -->
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Die.Zone}" Value="E0" />
                                                                    <Condition Binding="{Binding Summary.State}" Value="Clean" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Stroke" Value="#78909C" />
                                                                <Setter Property="Fill" Value="#2278909C" />
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Die.Zone}" Value="E0" />
                                                                    <Condition Binding="{Binding Summary.State}" Value="Defective" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Stroke" Value="#FB8C00" />
                                                                <Setter Property="Fill" Value="#33FB8C00" />
                                                            </MultiDataTrigger>
                                                            <DataTrigger Binding="{Binding Summary.State}" Value="Failed">
                                                                <Setter Property="Stroke" Value="#424242" />
                                                                <Setter Property="Fill" Value="#AA616161" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Stroke" Value="#1E88E5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>

                                            <!-- 결함 — die 안 좌표(Bounds)라 칸 안에 그대로 얹힌다 -->
                                            <ItemsControl Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                          ItemsSource="{Binding Defects.Items}" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                                                                   Stroke="#FFD600"
                                                                   StrokeThickness="{Binding DataContext.StrokePx, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 결함 수 — 칸 왼쪽 위 -->
                                            <Viewbox Grid.Row="0" Grid.Column="0" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding Summary.DefectCount}" Foreground="#B71C1C" FontWeight="Bold" Margin="2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Summary.State}" Value="Defective">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Viewbox>

                                            <!-- 검사 실패 — 칸 전체에 × -->
                                            <Viewbox Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
                                                <TextBlock Text="×" Foreground="White" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Summary.State}" Value="Failed">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Viewbox>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Viewbox>
                </Border>
            </DockPanel>

            <!-- ── 오른쪽: 멈춘 까닭 · 결과 · 정렬 · 골든 · 선택한 die ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6">
                    <!-- ★★ 멈춘 까닭이 맨 위다. 맵이 비어 있는 이유를 제일 먼저 읽게 -->
                    <Border Background="#FFEBEE" BorderBrush="#E53935" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StopReason}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StopReason}" TextWrapping="Wrap" Foreground="#B71C1C" />
                    </Border>

                    <!-- ★★ 터진 die — 결과 숫자보다 먼저 -->
                    <Border Background="#FFF3E0" BorderBrush="#FB8C00" BorderThickness="1" Padding="6" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FailureText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding FailureText}" TextWrapping="Wrap" Foreground="#E65100" FontWeight="Bold" />
                    </Border>

                    <GroupBox Header="결과" Padding="4">
                        <StackPanel>
                            <!-- ★ 어떤 레시피로 돌았나 — 숫자보다 먼저 본다. 시드면 설명에 "실데이터 값 아님" 이 뜬다 -->
                            <TextBlock Text="{Binding RecipeText}" TextWrapping="Wrap" Foreground="#555" FontSize="11" />

                            <!-- ★ 격자가 사진 일부만 덮으면 숫자보다 먼저 — 귀퉁이만 보고 '깨끗함' 이 나올 수 있다 -->
                            <TextBlock Text="{Binding CoverageWarning}" TextWrapping="Wrap"
                                       Foreground="#E65100" FontWeight="Bold" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CoverageWarning}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- ★ 원판인데 E0 레시피가 원판 밖을 안 가릴 때 — 숫자보다 먼저 -->
                            <TextBlock Text="{Binding EdgeWarning}" TextWrapping="Wrap"
                                       Foreground="#E65100" FontWeight="Bold" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EdgeWarning}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="정렬" Padding="4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding AlignmentText}" TextWrapping="Wrap" />
                    </GroupBox>

                    <GroupBox Header="골든 — 레시피가 요구하는 장수" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding NeedText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding NeedWarning}" TextWrapping="Wrap" Foreground="#E65100" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="선택한 die" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDie}" TextWrapping="Wrap" />
                            <TextBlock Text="맵의 칸을 누르면 그 die 의 결함이 여기 뜬다" Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDie}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding SelectedDie.Defects.Items}" Margin="0,4,0,0"
                                      SelectedItem="{Binding SelectedDefect}"
                                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontSize="11">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="36" />
                                    <DataGridTextColumn Header="die 안 위치" Binding="{Binding Bounds}" Width="*" />
                                    <DataGridTextColumn Header="면적" Binding="{Binding Area}" Width="52" />
                                    <DataGridTextColumn Header="밝기" Binding="{Binding MeanIntensity, StringFormat=F2}" Width="48" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </GroupBox>

                    <!-- ★ 맵은 축소본이라 결함 모양이 안 보인다. 표에서 결함을 고르면 그 둘레만 원본 해상도로 읽어 보인다.
                         그림 크기의 판 위에 결함 네모를 그대로 얹고, 늘이고 줄이는 건 Viewbox 가 한다(맵과 같은 수법). -->
                    <GroupBox Header="결함 원본 보기" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="위 표에서 결함을 고르면 그 둘레를 원본 해상도로 보여 준다" Foreground="Gray" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefectPatch}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Viewbox Stretch="Uniform" MaxHeight="260">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefectPatch}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Grid Width="{Binding PatchWidth}" Height="{Binding PatchHeight}">
                                    <Image Source="{Binding DefectPatch}" Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    <Canvas>
                                        <Rectangle Canvas.Left="{Binding DefectBox.X}" Canvas.Top="{Binding DefectBox.Y}"
                                                   Width="{Binding DefectBox.Width}" Height="{Binding DefectBox.Height}"
                                                   Stroke="#1E88E5" StrokeThickness="{Binding PatchStroke}" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="{Binding DefectText}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </DockPanel>
</Window>