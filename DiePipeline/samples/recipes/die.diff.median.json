{
  "recipeId": "die.diff.median",
  "description": "die-to-die 대안 — 부호 대신 중앙값으로 미러를 막는다. 이웃은 같은 행에서 거리를 늘려 3장을 웨이퍼 층이 채워 준다(끝 열도 3장). Median 은 안 닮은 이웃을 버리므로 멀리서 데려와도 손해가 없다. 그래서 Absolute 를 써도 오검이 0이고, 밝은 결함(이물질처럼 덧붙은 것)도 볼 수 있다. 대가는 속도 — 픽셀마다 정렬한다.",

  "contextInputs": [ "roi", "chipRegions" ],

  "pipeline": {
    "nodes": [
      {
        "id": "golden",
        "type": "Combine",
        "inputs": { "regions": "chipRegions" },
        "outputs": { "result": "golden" },
        "params": { "strategy": "Median" }
      },
      {
        "id": "diff",
        "type": "Difference",
        "inputs": { "test": "roi", "golden": "golden" },
        "outputs": { "result": "diff" },
        "params": { "windowSize": 3, "diffPolicy": "Absolute", "neighborMode": "MinMax" }
      },
      {
        "id": "binarize",
        "type": "Binarize",
        "inputs": { "src": "diff" },
        "outputs": { "result": "mask" },
        "params": { "method": "Threshold", "value": 0.2 }
      },
      {
        "id": "label",
        "type": "Label",
        "inputs": { "mask": "mask", "intensity": "roi" },
        "outputs": { "result": "defectList" },
        "params": { "connectivity": 8, "minArea": 500 }
      }
    ]
  }
}